---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../content/settings/site.json";

const entries: CollectionEntry<"services">[] = await getCollection("services");
const services: CollectionEntry<"services">[] = entries
  .filter((entry) => entry.data.status === "published")
  .sort((a, b) => a.data.order - b.data.order);
const serviceSymbols = ["✳", "✦", "◌", "↗"];
---

<BaseLayout
  title="Nos services"
  description="Déjeuner, dîner, traiteur, privatisation et livraison : découvrez les expériences du Jardin de Bastos à Yaoundé."
>
  <section class="page-intro page-intro--services" aria-labelledby="page-title">
    <div class="page-intro__copy">
      <p class="eyebrow eyebrow--light">Le Jardin, à votre façon</p>
      <h1 id="page-title">Les beaux moments <em>ont leur adresse.</em></h1>
      <p>
        Une table pour se retrouver, un jardin pour célébrer, les saveurs du Chef
        là où l'occasion vous appelle.
      </p>
    </div>
    <div class="page-intro__ornament" aria-hidden="true">
      <span class="page-intro__ornament-ring"></span>
      <span class="page-intro__ornament-leaf"></span>
      <span class="page-intro__ornament-dot"></span>
    </div>
    <div class="page-intro__foot">
      <span>Bastos, Yaoundé</span><span aria-hidden="true">✳</span><span>Quatre façons de vivre le Jardin</span>
    </div>
  </section>

  <section class="services-list section-pad" aria-label="Les services du Jardin">
    {
      services.map((service, index) => {
        const message = encodeURIComponent(service.data.whatsappMessage);
        const contactUrl = `https://wa.me/${site.whatsapp.number}?text=${message}`;
        const actionNames = {
          reservation: "Réserver via WhatsApp",
          quote: "Demander un devis via WhatsApp",
          order: "Commander via WhatsApp",
        };

        return (
          <article class={`service-row ${index % 2 ? "service-row--reverse" : ""}`}>
            <div class={`service-art service-art--${index + 1}`} aria-hidden="true">
              <span class="service-art__symbol">{serviceSymbols[index]}</span>
              <span class="service-art__number">0{index + 1}</span>
              <span class="service-art__line"></span>
              <span class="service-art__word">{service.data.eyebrow}</span>
            </div>
            <div class="service-copy">
              <div class="section-kicker"><span>0{index + 1}</span><span>{service.data.eyebrow}</span></div>
              <h2>{service.data.title}</h2>
              <p>{service.data.description}</p>
              <ul>
                {service.data.details
                  .split("\n")
                  .map((detail: string) => detail.trim())
                  .filter((detail: string) => detail.length > 0)
                  .map((detail: string) => <li>{detail}</li>)}
              </ul>
              <a
                class="button button--dark"
                href={contactUrl}
                target="_blank"
                rel="noreferrer"
                aria-label={`${actionNames[service.data.action]} — ${service.data.title} (nouvel onglet)`}
              >
                {service.data.actionLabel} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        );
      })
    }
  </section>

  <section class="service-note section-pad section-pad--cream">
    <p class="eyebrow">Un projet en tête ?</p>
    <h2>Parlons-en <em>ensemble.</em></h2>
    <p>Écrivez-nous : nous prendrons le temps d'imaginer la formule qui vous ressemble.</p>
    <a class="text-link" href="/contact/">
      Contacter le Jardin <span aria-hidden="true">↗</span>
    </a>
  </section>
</BaseLayout>
