---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../content/settings/site.json";

const dishEntries: CollectionEntry<"dishes">[] = await getCollection("dishes");
const galleryEntries: CollectionEntry<"gallery">[] = await getCollection("gallery");
const testimonialEntries: CollectionEntry<"testimonials">[] =
  await getCollection("testimonials");
const isEditorialPreview = import.meta.env.DEV;
const dishes: CollectionEntry<"dishes">[] = dishEntries
  .filter((entry) => entry.data.status === "published" || isEditorialPreview)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const gallery: CollectionEntry<"gallery">[] = galleryEntries
  .filter((entry) => entry.data.status === "published" && entry.data.image)
  .sort((a, b) => a.data.order - b.data.order);
const testimonials: CollectionEntry<"testimonials">[] = testimonialEntries
  .filter((entry) => entry.data.status === "published")
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const reservationMessage = encodeURIComponent(
  "Bonjour Le Jardin de Bastos, je souhaiterais réserver une table.",
);
const reservationUrl = `https://wa.me/${site.whatsapp.number}?text=${reservationMessage}`;
const taglineParts = site.tagline.split(/(afro-fusion)/i);
const galleryMotifs = [
  "La lumière du jardin",
  "L'art de la table",
  "Le parfum des épices",
  "Le goût du partage",
  "Le geste du Chef",
  "Un soir à Bastos",
];
---

<BaseLayout
  title={site.name}
  description="Une cuisine afro-fusion raffinée au cœur de Bastos, Yaoundé. Découvrez Le Jardin, ses saveurs et son art de recevoir."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="eyebrow eyebrow--light"><span></span> Bastos · Yaoundé · Depuis 2022</p>
      <h1 id="hero-title">
        {taglineParts.map((part) =>
          part.toLowerCase() === "afro-fusion" ? <em>{part}</em> : part
        )}
      </h1>
      <p class="hero__intro">
        La chaleur du feu, la fraîcheur du jardin, les saveurs du terroir
        camerounais. Une table où les beaux moments prennent leur temps.
      </p>
      <div class="hero__actions">
        <a
          class="button button--gold"
          href={reservationUrl}
          target="_blank"
          rel="noreferrer"
        >
          Réserver une table <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link text-link--light" href="/services/">
          Entrer dans le Jardin <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="hero__foot">
        <span>Une adresse à Bastos</span>
        <span class="hero__foot-line"></span>
        <span>11h30 — 23h30</span>
      </div>
    </div>
    <figure class="hero__art">
      {
        site.heroImage ? (
          <img
            src={site.heroImage}
            alt={site.heroImageAlt || "Terrasse du Jardin de Bastos"}
            width="1000"
            height="1200"
            fetchpriority="high"
          />
        ) : (
          <img
            src="/images/terrasse-illustration.svg"
            alt=""
            width="1000"
            height="1200"
            fetchpriority="high"
          />
        )
      }
      <figcaption class="hero__art-note">
        {
          site.heroImage
            ? "Le Jardin de Bastos · Bastos, Yaoundé"
            : "Illustration de direction · photo officielle à intégrer"
        }
      </figcaption>
      <span class="hero__stamp" aria-hidden="true">
        <span>UN JARDIN</span>
        <span class="hero__stamp-star">✳</span>
        <span>À BASTOS</span>
      </span>
    </figure>
    <a class="hero__scroll" href="#histoire" aria-label="Découvrir le Jardin">
      <span>Défiler</span><span aria-hidden="true">↓</span>
    </a>
  </section>

  <section class="story section-pad" id="histoire" aria-labelledby="story-title">
    <div class="section-kicker"><span>01</span><span>Un lieu, une intention</span></div>
    <div class="story__grid">
      <div class="story__heading">
        <p class="eyebrow">Une parenthèse à Bastos</p>
        <h2 id="story-title">La ville s'efface.<br /><em>Le jardin vous accueille.</em></h2>
      </div>
      <div class="story__text">
        <p>{site.story.intro}</p>
        <p>{site.story.chef}</p>
        <a class="text-link" href="/contact/">
          Faire connaissance <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="story__details">
      <div class="story__detail">
        <span class="story__detail-number">60</span>
        <span>couverts en salle</span>
      </div>
      <span class="story__detail-rule" aria-hidden="true"></span>
      <div class="story__detail">
        <span class="story__detail-number">40</span>
        <span>places au jardin</span>
      </div>
      <span class="story__detail-rule" aria-hidden="true"></span>
      <div class="story__detail">
        <span class="story__detail-number">02</span>
        <span>ambiances, une même table</span>
      </div>
    </div>
  </section>

  {
    dishes.length > 0 && (
      <section class="menu-preview section-pad section-pad--cream" aria-labelledby="menu-title">
    <div class="section-heading">
      <div>
        <div class="section-kicker"><span>02</span><span>Quelques notes de la carte</span></div>
        <p class="eyebrow">Le terroir, en mouvement</p>
        <h2 id="menu-title">Des saveurs qui <em>restent.</em></h2>
      </div>
      <p class="section-heading__aside">
        Des produits d'ici, des épices de Penja, et le geste du Chef Armand Nkodo.
        La carte définitive se découvre à table.
      </p>
    </div>
    <div class="dish-list">
      {
        dishes.map((dish, index) => (
          <article class={`dish-row ${index % 2 ? "dish-row--reverse" : ""}`}>
            <div class={`dish-art dish-art--${index + 1}`} aria-hidden="true">
              {dish.data.image ? (
                <img src={dish.data.image} alt="" loading="lazy" width="720" height="640" />
              ) : (
                <>
                  <span class="dish-art__orbit"></span>
                  <span class="dish-art__plate">
                    <span class="dish-art__garnish"></span>
                  </span>
                  <span class="dish-art__number">0{index + 1}</span>
                </>
              )}
              {dish.data.status === "draft" && (
                <span class="content-badge">À valider avec le Chef</span>
              )}
            </div>
            <div class="dish-copy">
              <span class="dish-copy__index">0{index + 1} / 04</span>
              <p class="eyebrow">{dish.data.category}</p>
              <h3>{dish.data.title}</h3>
              <p>{dish.data.description}</p>
              <a class="text-link" href="/contact/">
                Nous parler de la carte <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
        {isEditorialPreview && dishes.some((dish) => dish.data.status === "draft") && (
          <p class="editorial-note">
            Les exemples et créations en attente de validation sont signalés. La carte et ses photographies
            seront complétées avec le Chef avant la publication définitive.
          </p>
        )}
      </section>
    )
  }

  {
    (gallery.length > 0 || isEditorialPreview) && (
      <section class="gallery-section section-pad" aria-labelledby="gallery-title">
    <div class="section-heading section-heading--gallery">
      <div>
        <div class="section-kicker"><span>03</span><span>Instants de vie</span></div>
        <p class="eyebrow">L'esprit du Jardin</p>
        <h2 id="gallery-title">Un lieu à <em>ressentir.</em></h2>
      </div>
      <p class="section-heading__aside">
        Une salle qui se prolonge sous les arbres, une lumière douce, le plaisir de se retrouver.
      </p>
    </div>
    {
      gallery.length ? (
        <div class="photo-grid">
          {gallery.slice(0, 6).map((photo) => (
            <figure class="photo-grid__item">
              <img
                src={photo.data.image}
                alt={photo.data.imageAlt || photo.data.title}
                loading="lazy"
                width="720"
                height="820"
              />
              <figcaption>{photo.data.title}</figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <>
          <div class="gallery-motifs">
            {galleryMotifs.map((motif, index) => (
              <figure class={`gallery-motif gallery-motif--${index + 1}`}>
                <div class="gallery-motif__art" aria-hidden="true">
                  <span class="gallery-motif__shape"></span>
                  <span class="gallery-motif__orbit"></span>
                  <span class="gallery-motif__index">0{index + 1}</span>
                </div>
                <figcaption>{motif}</figcaption>
              </figure>
            ))}
          </div>
          <p class="editorial-note">
            Études graphiques temporaires — les photographies du restaurant seront intégrées à cette galerie.
          </p>
        </>
      )
    }
      </section>
    )
  }

  {
    testimonials.length ? (
      <section class="voices section-pad section-pad--green" aria-labelledby="voices-title">
        <div class="section-kicker section-kicker--light"><span>04</span><span>Paroles de convives</span></div>
        <div class="section-heading section-heading--voices">
          <div>
            <p class="eyebrow eyebrow--light">Les mots de celles et ceux qui sont venus</p>
            <h2 id="voices-title">Le souvenir <em>reste à table.</em></h2>
          </div>
        </div>
        <div class="voices__grid">
          {testimonials.map((item) => (
            <figure class="voice">
              <span class="voice__mark" aria-hidden="true">“</span>
              <blockquote>{item.data.quote}</blockquote>
              <figcaption>
                <strong>{item.data.name}</strong>
                {item.data.context && <span>{item.data.context}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    ) : null
  }

  <section class="closing section-pad" aria-labelledby="closing-title">
    <p class="eyebrow">Il ne manque que vous</p>
    <h2 id="closing-title">À bientôt <em>au Jardin.</em></h2>
    <p>Du mardi au dimanche · 11h30 — 23h30</p>
    <a class="button button--dark" href={reservationUrl} target="_blank" rel="noreferrer">
      Réserver votre table <span aria-hidden="true">↗</span>
    </a>
  </section>
</BaseLayout>
