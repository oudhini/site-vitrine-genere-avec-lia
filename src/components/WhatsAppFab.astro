---
import site from "../content/settings/site.json";

const message = encodeURIComponent(site.whatsapp.greeting);
const url = `https://wa.me/${site.whatsapp.number}?text=${message}`;
---

<a
  class="whatsapp-fab"
  href={url}
  target="_blank"
  rel="noreferrer"
  aria-label="Contacter Le Jardin de Bastos sur WhatsApp (nouvel onglet)"
>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
    <path
      d="M20.1 11.6a8.1 8.1 0 0 1-12 7.1L4 20l1.3-3.9a8.1 8.1 0 1 1 14.8-4.5Z"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      d="M9 8.3c.2-.4.5-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.6c.1.2.1.4 0 .5l-.5.7c-.2.2-.2.4 0 .7.3.5.7.9 1.2 1.2.2.1.4.2.6 0l.7-.5c.2-.1.4-.2.6-.1l1.6.7c.3.1.4.3.4.5v.5c0 .2 0 .5-.4.7-.5.3-1.2.5-2 .3-1-.2-2-.7-3-1.6-1-.9-1.6-1.9-1.8-2.9-.2-.9 0-1.6.3-2.1Z"
      fill="currentColor"
    />
  </svg>
  <span>Écrivez-nous</span>
</a>
