---
import site from "../content/settings/site.json";

const links = [
  { href: "/", label: "Le Jardin" },
  { href: "/services/", label: "Nos services" },
  { href: "/contact/", label: "Nous trouver" },
];
const currentPath = Astro.url.pathname;
const reservationMessage = encodeURIComponent(
  "Bonjour Le Jardin de Bastos, je souhaiterais réserver une table.",
);
const reservationUrl = `https://wa.me/${site.whatsapp.number}?text=${reservationMessage}`;
---

<a class="skip-link" href="#contenu">Aller au contenu</a>
<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="Le Jardin de Bastos — accueil">
      <span class="brand__monogram" aria-hidden="true">J<span>.</span></span>
      <span class="brand__name">Le Jardin <span>de Bastos</span></span>
    </a>
    <nav class="site-nav" aria-label="Navigation principale">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={currentPath === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <a
      class="button button--header"
      href={reservationUrl}
      target="_blank"
      rel="noreferrer"
      aria-label="Réserver une table sur WhatsApp (nouvel onglet)"
    >
      <span>Réserver</span>
      <span class="button__arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</header>
